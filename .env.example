# InvoiceIQ v2.0 Environment Configuration
PROJECT_NAME="InvoiceIQ API"
VERSION="2.0.0"
DATABASE_URL="sqlite:///./invoiceiq.db"

# ── Vision LLM API Keys (Optional — Demo Engine works out-of-the-box) ──────────
GROQ_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ── OCR Backend: "easyocr" (default) | "tesseract" | "pil" (fallback) ──────────
OCR_BACKEND="easyocr"

# ── Authentication (leave empty for open/demo mode) ─────────────────────────────
# Set a strong random string to protect all mutation endpoints with X-API-Key header
API_SECRET_KEY=""

# ── Analytics Base Currency ──────────────────────────────────────────────────────
# All spend amounts normalized to this currency in analytics
BASE_CURRENCY="USD"

# ── Webhook Integration ──────────────────────────────────────────────────────────
DEFAULT_WEBHOOK_URL="https://primary-n8n-instance.hooks.n8n.cloud/webhook/invoiceiq"

# ── Google Sheets Integration ────────────────────────────────────────────────────
# 1. Create a Google Cloud service account, download JSON key
# 2. Share your target Google Sheet with the service account email
# 3. Set the path to the JSON key file and the sheet ID (from the URL)
GOOGLE_SERVICE_ACCOUNT_JSON="/path/to/service-account-credentials.json"
GOOGLE_SHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms"

# ── Airtable Integration ─────────────────────────────────────────────────────────
# 1. Get your personal access token from https://airtable.com/account
# 2. Copy your base ID from the Airtable URL: airtable.com/{BASE_ID}/{TABLE}
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
AIRTABLE_TABLE_NAME="Invoices"
